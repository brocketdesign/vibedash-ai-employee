# ============================================================
# VibeDash — AI Employee
# ============================================================
# Copy to .env.local for development. On Vercel, set these as project
# environment variables instead.

# ── Core (required) ─────────────────────────────────────────
# The app will not start without these.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/vibedash
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── The employee's brain (required for any autonomous work) ──
# Novita, OpenAI-compatible. Get a key at https://novita.ai (Key Management).
# The same key powers both the LLM API and the Agent Sandbox.
NOVITA_API_KEY=sk_...
# Optional overrides. Defaults are DeepSeek V4 Flash for the workhorse calls and
# DeepSeek V4 Pro for planning and judgement.
# NOVITA_MODEL=deepseek/deepseek-v4-flash
# NOVITA_REASONING_MODEL=deepseek/deepseek-v4-pro
# NOVITA_BASE_URL=https://api.novita.ai/openai/v1
# Base image for the build sandbox template.
# NOVITA_TEMPLATE_IMAGE=node:22-bookworm

# ── Hosting VPS (required to ship websites) ─────────────────
# A Hostinger (or any Ubuntu) VPS running scripts/vps-agent.js on port 7854.
# Provision it with: MGMT_SECRET=... BASE_DOMAIN=... bash scripts/setup-vps.sh
# HOSTINGER_MGMT_SECRET below must equal the MGMT_SECRET you gave the script.
HOSTINGER_HOST_VPS_IP=203.0.113.10
HOSTINGER_MGMT_SECRET=a-long-random-shared-secret
# Companies are published at {slug}.{VPS_ROOT_DOMAIN}. Point a wildcard
# A record (*.your-domain) at the VPS IP.
VPS_ROOT_DOMAIN=example.com
# VPS_AGENT_PORT=7854

# ── Social auto-posting (required for the Social capability) ─
# https://zernio.com — connect the company's X account through the dashboard.
ZERNIO_API_KEY=sk_...
# ZERNIO_BASE_URL=https://zernio.com/api/v1

# ── Email (required for outreach + night shift reports) ─────
RESEND_API_KEY=re_...
# Sender for every email the app sends; its domain must be verified in Resend.
# Unset, mail goes from Resend's test sender, which only delivers to your own address.
# EMAIL_FROM="VibeDash <notifications@your-domain.com>"
# Optional reply-to address for those emails.
# EMAIL_REPLY_TO=support@your-domain.com
# Support address shown on the landing, terms and privacy pages.
# NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.com

# ── Billing ($20/mo plan) ───────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Point the Stripe webhook at /api/webhooks/stripe and subscribe to:
#   checkout.session.completed, invoice.paid,
#   invoice.payment_failed, customer.subscription.deleted

# ── Night shift cron ────────────────────────────────────────
# Vercel Cron authenticates itself; this secret is for manual triggers:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://.../api/cron/night-shift
CRON_SECRET=another-long-random-secret

# ── Legacy project workspace (optional) ─────────────────────
# Only needed for the /workspace pages inherited from the original VibeDash.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# AI review and advisor pages: Grok (xAI) is used first, OpenAI as the fallback.
# GROK_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
